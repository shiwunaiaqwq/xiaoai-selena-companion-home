    "source_revision": 95569,
    "scene": "幻境舞会中的邀请，仅取邀请表达",
    "use_rule": "用于表达心意或邀请，不据此虚构当下发生了原场景；伊利斯是赛琳娜的笔名"
  },
  {
    "id": "Q007",
    "slot": "any",
    "text": "要一起去别处走走吗？",
    "kind": "canon_quote",
    "official_quote": true,
