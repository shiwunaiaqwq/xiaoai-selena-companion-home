  },
  {
    "id": "Q006",
    "slot": "any",
    "text": "可以请您，和我共舞一曲吗？",
    "kind": "canon_quote",
    "official_quote": true,
    "excerpt": false,
    "source_titles": [
      "赛琳娜·幻奏·其之二"
    ],
    "sources": [
