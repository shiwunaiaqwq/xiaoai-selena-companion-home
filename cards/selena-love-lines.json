  },
  {
    "id": "Q028",
    "slot": "any",
    "text": "愿意与我共同演奏一曲吗？",
    "kind": "canon_quote",
    "official_quote": true,
    "excerpt": false,
    "source_titles": [
      "宿舍伙伴/赛琳娜·幻奏/宿舍对话"
