  },
  {
    "id": "Q005",
    "slot": "any",
    "text": "我……很想见到你",
    "kind": "canon_quote",
    "official_quote": true,
    "excerpt": true,
    "source_titles": [
      "逐舞"
    ],
    "sources": [
